pkgname=restic-bin
pkgver=0.18.0
pkgrel=1
pkgdesc="Fast, secure, efficient backup program"
arch=(x86_64)
url="https://github.com/restic/restic"
license=(BSD)

source=(https://github.com/restic/restic/releases/download/v$pkgver/restic_${pkgver}_linux_amd64.bz2)
md5sums=('a8b71e2b123460645b0f9f74d236716a')

build(){
    echo
}

package(){
    mkdir -p ${pkgdir}/usr/local/bin
    chmod +x restic_${pkgver}_linux_amd64
    cp -r restic_${pkgver}_linux_amd64 ${pkgdir}/usr/local/bin/restic
}
