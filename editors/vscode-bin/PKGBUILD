pkgname=vscode-bin
pkgver=1.103.1
pkgrel=1
pkgdesc="Source code editor developed by Microsoft"
arch=(x86_64)
url="https://github.com/microsoft/vscode"
license=(Proprietary)

source=(${pkgname}-${pkgver}.tar.gz::https://update.code.visualstudio.com/$pkgver/linux-x64/stable)
md5sums=('b667c53628eaff9531225f168cf18bf7')

build() {
    cat << EOF > ${pkgname}.desktop
    [Desktop Entry]
    Comment=VSCode
    Exec=code
    GenericName=Text Editor
    Icon=/usr/local/lib/${pkgname}/resources/app/resources/linux/code.png
    Name=Visual Studio Code
    NoDisplay=false
    StartupNotify=true
    Terminal=false
    Type=Application
    X-KDE-SubstituteUID=false
EOF
}

package(){
    mkdir -p ${pkgdir}/usr/local/lib/${pkgname}
    cp -r VSCode-linux-x64/* ${pkgdir}/usr/local/lib/${pkgname}

    mkdir -p ${pkgdir}/usr/local/bin
    ln -s /usr/local/lib/${pkgname}/code ${pkgdir}/usr/local/bin/

    mkdir -p ${pkgdir}/usr/local/share/applications
    cp ${pkgname}.desktop ${pkgdir}/usr/local/share/applications/
}
