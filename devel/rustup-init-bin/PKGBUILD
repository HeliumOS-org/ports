pkgname=rustup-init-bin
pkgver=1.28.2
pkgrel=1
pkgdesc="An installer for the systems programming language Rust"
arch=(x86_64)
url="https://rustup.rs/"
license=(MIT)

source=(https://raw.githubusercontent.com/rust-lang/rustup/refs/tags/$pkgver/rustup-init.sh)
md5sums=('ddcc91013258e42c0df0ec1c26c92359')

build(){
    echo
}

package(){
    mkdir -p ${pkgdir}/usr/local/bin
    chmod +x rustup-init.sh
    cp -r rustup-init.sh ${pkgdir}/usr/local/bin/rustup-init
}
